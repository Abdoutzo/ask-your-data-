# Copy to .env and fill in what you use. Nothing here is required to run
# the retrieval evals on the sample corpus; keys are only needed for answer
# generation and the faithfulness judge.

# LLM provider: mistral | openai | none
LLM_PROVIDER=mistral

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval defaults
CHUNK_STRATEGY=recursive
TOP_K=5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
